#!/bin/bash
# Guard rail: validate Conventional Commits format across all agents (ADR-0011)
# Applies to Claude Code, Aider, manual git, any subprocess invoking git commit.
# Companion to scripts/hooks/commit-guard.js (Claude Code PreToolUse fail-fast).
#
# Rules:
#   - Conventional Commits: type(scope): description
#   - Subject line <= 72 chars
#   - No trailing period
#   - Lowercase description
#
# To bypass (NOT recommended): git commit --no-verify
# To uninstall: git config --global --unset core.hooksPath

set -u

MSG_FILE="$1"
[ -z "$MSG_FILE" ] && exit 0
[ -f "$MSG_FILE" ] || exit 0

MSG=$(head -n 1 "$MSG_FILE")

[ -z "$MSG" ] && exit 0

# Skip auto-generated commits (merge, revert, fixup/squash)
case "$MSG" in
    Merge*|Revert*|fixup\!*|squash\!*|\#*) exit 0 ;;
esac

# ADR-0011 Addendum 2026-05-17 (policy-C): ban Co-Authored-By trailer (Layer 2;
# covers Aider/manual/external agents that bypass the Claude PreToolUse hook).
# Scans the FULL message (trailer is at the bottom, not the subject line).
if grep -qiE 'co-authored-by[[:space:]]*:' "$MSG_FILE"; then
    echo 'commit-msg hook block -- ADR-0011 policy-C: "Co-Authored-By:" trailer VIETATO.' >&2
    echo '  Usa trailer metadata: Coding-Agent: <agent-id> + Trace-Id: <uuidv7>.' >&2
    exit 1
fi

errors=()

# ADR-0011 trailer adoption reale (2026-07-25, coda D3): sui repo del progetto
# pathfinder i trailer Coding-Agent: e Trace-Id: sono OBBLIGATORI (prima
# warn-only via PreToolUse). Scoped per path: gli altri repo non cambiano.
toplevel=$(git rev-parse --show-toplevel 2>/dev/null || true)
case "$toplevel" in
    *pathfinder*)
        # Presenza E valore usabile: niente id vuoto, niente variabile non espansa
        # (es. "Coding-Agent: $AGENT"). Nessun regex sull'id: e' libero per costruzione,
        # cambia da agente ad agente. Si vieta solo cio' che non puo' essere un id vero.
        AGENT_RE='^coding-agent[[:space:]]*:[[:space:]]*[^[:space:]$]+[^$]*$'
        if ! grep -qiE '^coding-agent[[:space:]]*:' "$MSG_FILE"; then
            errors+=("Missing required trailer: Coding-Agent: <agent-id> (ADR-0011)")
        elif ! grep -qiE "$AGENT_RE" "$MSG_FILE"; then
            found=$(grep -iE '^coding-agent[[:space:]]*:' "$MSG_FILE" | head -n 1)
            errors+=("Coding-Agent vuoto o non espanso -- serve un id reale. Trovato: ${found}")
        fi
        # Presenza E forma: un trailer presente ma non espanso (es. "Trace-Id: $TID")
        # passava il controllo e produceva un commit senza traccia. Successo il 2026-08-10.
        #
        # Si blocca solo cio' che NON PUO' essere un id (vuoto, variabile non espansa);
        # tutto il resto passa, con avviso se non e' uuidv7. Misura sul corpus reale il
        # 2026-08-11 (266 Trace-Id dall'adozione): 70 uuidv7, 167 uuid di altra versione,
        # 29 slug leggibili tipo "fasea-dati". Esigere la v7 avrebbe bloccato 196 commit
        # legittimi; esigere la forma uuid ne avrebbe bloccati 29, chiudendo di nascosto
        # la decisione uuid-vs-slug che e' dichiarata APERTA.
        # Se il trailer manca del tutto, lo genera l'hook -- come Gerrit fa col Change-Id.
        # Un id digitato a mano e' esattamente il modo in cui nasce "Trace-Id: $TID".
        # Richiede che Coding-Agent ci sia gia': quello dice CHI, e non si puo' inventare.
        if ! grep -qiE '^trace-id[[:space:]]*:' "$MSG_FILE" \
           && grep -qiE '^coding-agent[[:space:]]*:' "$MSG_FILE"; then
            ms=$(date +%s%3N)
            rand=$(od -An -tx1 -N10 /dev/urandom | tr -d ' \n')
            hi=$(printf '%012x' "$ms")
            ver=7${rand:0:3}
            var=$(printf '%x' $(( 0x8 + (0x${rand:3:1} % 4) )))${rand:4:3}
            uuid="${hi:0:8}-${hi:8:4}-${ver}-${var}-${rand:7:12}"
            printf 'Trace-Id: %s\n' "$uuid" >> "$MSG_FILE"
            echo "commit-msg -- Trace-Id assente, generato: ${uuid}" >&2
        fi
        TRACE_USABLE_RE='^trace-id[[:space:]]*:[[:space:]]*[^[:space:]$]+[^$]*$'
        UUIDV7_RE='^trace-id[[:space:]]*:[[:space:]]*[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}[[:space:]]*$'
        if ! grep -qiE '^trace-id[[:space:]]*:' "$MSG_FILE"; then
            errors+=("Missing required trailer: Trace-Id: <uuidv7> (ADR-0011)")
        elif ! grep -qiE "$TRACE_USABLE_RE" "$MSG_FILE"; then
            found=$(grep -iE '^trace-id[[:space:]]*:' "$MSG_FILE" | head -n 1)
            errors+=("Trace-Id vuoto o non espanso -- serve un id reale. Trovato: ${found}")
        elif ! grep -qiE "$UUIDV7_RE" "$MSG_FILE"; then
            echo "commit-msg avviso -- Trace-Id valido ma non uuidv7: ADR-0011 preferisce la v7." >&2
        fi
        ;;
esac

TYPE_RE='(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)'

if ! echo "$MSG" | grep -qE "^${TYPE_RE}(\(.+\))?!?:[[:space:]].+"; then
    errors+=("Message does not follow conventional commit format: type(scope): description")
fi

msg_len=${#MSG}
if [ "$msg_len" -gt 72 ]; then
    errors+=("Subject line is ${msg_len} chars (max 72)")
fi

case "$MSG" in
    *.) errors+=("Subject line should not end with a period") ;;
esac

desc=$(echo "$MSG" | sed -E "s/^${TYPE_RE}(\(.+\))?!?:[[:space:]]+//")
first_char="${desc:0:1}"
case "$first_char" in
    [A-Z]) errors+=("Description should start with lowercase letter") ;;
esac

if [ ${#errors[@]} -gt 0 ]; then
    echo "commit-msg hook block -- commit message issues:" >&2
    for e in "${errors[@]}"; do
        echo "  - $e" >&2
    done
    echo "" >&2
    echo "Subject: ${MSG}" >&2
    exit 1
fi

exit 0
